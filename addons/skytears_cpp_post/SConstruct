#!/usr/bin/env python3
# Build SkyTears GDExtension against the official godot-cpp 4.5 bindings.
import os

if not os.path.isfile('godot-cpp/SConstruct'):
    raise RuntimeError('Missing godot-cpp/SConstruct. GitHub Actions must clone godot-cpp first.')

local_env = Environment(tools=['default'], PLATFORM='')
env = local_env.Clone()
env = SConscript('godot-cpp/SConstruct', {
    'api_version': '4.5', 'env': env, 'customs': []
})
env.Append(CPPPATH=['src'])
if env['target'] == 'template_release' and env['platform'] == 'linux':
    env.Append(CXXFLAGS=['-O3'])

suffix = env['suffix'].replace('.dev', '').replace('.universal', '')
libname = '{}{}{}{}'.format(env.subst('$SHLIBPREFIX'), 'skytears_cpp_post', suffix, env.subst('$SHLIBSUFFIX'))
library = env.SharedLibrary('bin/' + libname, source=Glob('src/*.cpp'))
Default(library)
